// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id
  name        String
  description String   @default("")
  category    String   @default("")
  price       Int?     // null = "السعر عند الطلب"
  image       String   @default("")  // cover (first image)
  images      String   @default("")  // ~~~-separated list
  featured    Boolean  @default(false)
  inStock     Boolean  @default(true)
  // Encoded variations string (see lib/products.ts joinVariations/parseVariations)
  variations  String   @default("")
  // Newline-separated highlights (key selling points)
  highlights  String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
