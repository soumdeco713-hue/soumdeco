DATABASE_URL=file:/home/z/my-project/db/custom.db

# ============================================================
# Google Apps Script web app URL
# ============================================================
# Leave commented to use the built-in SEED_PRODUCTS (29 Soum Deco demo
# products with public Cloudinary URLs). Uncomment and replace with
# YOUR own Apps Script web app URL once you've set up your Google Sheet.
#
# Steps to get your own URL:
#   1. Import El-Miizaan-Sheet-Template.xlsx into Google Sheets
#   2. Extensions → Apps Script → paste apps-script.gs → Save
#   3. Run `setupAllSheets` → Allow permissions
#   4. Deploy → New deployment → Web app → Me → Anyone → copy URL
#   5. Paste the URL below and uncomment the line
# ============================================================
# NEXT_PUBLIC_SHEET_URL=https://script.google.com/macros/s/AKfycbyp59qPpZuP0XCDW50Zn6-v_uwA-aSkEXe9Z_Sew0Zy6wWlQqO7HyN6Q07od6vU-oIQvw/exec

# ============================================================
# Cloudinary (image hosting for admin product uploads)
# ============================================================
# Replace with YOUR own Cloudinary credentials (free at cloudinary.com).
# Until then, the site uses the reference site's public Cloudinary URLs
# for the 29 demo products (no uploads possible).
# ============================================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=soumdeco
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=soumdeco
