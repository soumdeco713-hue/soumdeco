# === REQUIRED ===
NEXT_PUBLIC_SHEET_URL=<your_google_apps_script_url>
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=<your_cloudinary_cloud_name>
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=<your_cloudinary_upload_preset>

# === WORKER (for live updates — optional but recommended) ===
NEXT_PUBLIC_WORKER_URL=<your_cloudflare_worker_url>
NEXT_PUBLIC_WORKER_ADMIN_SECRET=<random_64_char_hex_string>

# === TELEGRAM BOT (optional — leave empty to disable) ===
NEXT_PUBLIC_TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_CHAT_ID=
