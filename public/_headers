# Cloudflare Pages headers — optimized for speed + correctness
# Rule: More specific paths override less specific ones
# The /* rule is REMOVED because it conflicts with caching rules below

# HTML (root) — never cache (always get latest HTML)
/
  Cache-Control: no-cache, must-revalidate
  Pragma: no-cache
  Expires: 0

# Static assets (JS/CSS) — cache for 1 year (immutable, hashed filenames)
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Images — cache for 1 day
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Static data files — 5 min cache + stale-while-revalidate
/data/products.json
  Cache-Control: public, max-age=300, stale-while-revalidate=3600

/data/stock.csv
  Cache-Control: public, max-age=300, stale-while-revalidate=3600

/data/wilayas.json
  Cache-Control: public, max-age=86400

/data/communes.json
  Cache-Control: public, max-age=86400

# Manifest + seed — cache for 1 hour
/image-manifest.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/stock-seed.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Logo — cache for 1 day
/logo.jpg
  Cache-Control: public, max-age=86400

# Service worker un-registration script — never cache
/unregister-sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# 404 page — never cache
/404.html
  Cache-Control: no-cache, must-revalidate

# All other HTML pages — never cache
/*.html
  Cache-Control: no-cache, must-revalidate
