# Cloudflare Pages headers — prevents stale cache on all browsers
# This works WITHOUT a service worker (compatible with all browsers)

# HTML files — NEVER cache (always fetch latest)
# This is the KEY fix: ensures users always get the latest HTML
/*
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Static assets — cache for 1 year (immutable, hashed filenames)
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Images — cache for 1 day (re-validate)
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Manifest + seed — cache for 1 hour (re-validate)
/image-manifest.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/stock-seed.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Logo — cache for 1 day
/logo.jpg
  Cache-Control: public, max-age=86400

# Service worker un-registration script — NEVER cache
/unregister-sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Static data files — 5 min CDN cache + 1 hour stale-while-revalidate
/data/products.json
  Cache-Control: public, max-age=300, stale-while-revalidate=3600

/data/stock.csv
  Cache-Control: public, max-age=300, stale-while-revalidate=3600
